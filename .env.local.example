# Copia este archivo a .env.local y complétalo con los datos de tu proyecto
# Supabase (Configuración del proyecto > API en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Generador Pedagógico IA (Fase 4) — nunca se exponen al navegador,
# solo se usan en Route Handlers de servidor (app/api/ai/**).
ANTHROPIC_API_KEY=TU_ANTHROPIC_API_KEY
GEMINI_API_KEY=TU_GEMINI_API_KEY
